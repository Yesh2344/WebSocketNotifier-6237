# Example environment variables for WebSocketNotifier
# Copy this file to .env and adjust values as needed.

# Server host (default: 0.0.0.0)
HOST=0.0.0.0

# Server port (default: 9002)
PORT=9002

# Path to log file (default: logs/websocket_notifier.log)
LOG_FILE=logs/websocket_notifier.log

# Log level: trace, debug, info, warn, error, critical
LOG_LEVEL=info